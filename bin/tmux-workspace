#!/usr/bin/env python3
"""Personal tmux controls and private, allowlisted workspace recovery."""
import contextlib
import fcntl
import json
import os
from pathlib import Path
import re
import runpy
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
import uuid

ROOT = Path(os.environ.get('TMUX_WORKSPACE_STATE_DIR', Path.home() / '.local/state/tmux-workspace')).expanduser()
SELF = str(Path(__file__).resolve())
TMUX = shutil.which('tmux') or '/opt/homebrew/bin/tmux'
PARKING = '__parked'
APP_COMMANDS = {'claude': ['claude', '--resume'], 'codex': ['codex', 'resume'], 'omp': ['omp', '--resume'], 'nvim': ['nvim', '-S']}
SEP = '\x1f'
os.umask(0o077)
PROJECTS_ROOT = (Path.home() / 'Projects').resolve()


def tm(*args, check=True):
    return subprocess.run([TMUX, *map(str, args)], capture_output=True, text=True, check=check).stdout.rstrip('\n')


def option(name, target=None):
    args = ['show-options', '-qv']
    args += ['-p', '-t', target] if target else ['-g']
    return tm(*args, name, check=False)


def put(name, value, target=None):
    tm('set-option', *(['-p', '-t', target] if target else ['-g']), name, str(value))


def fields(command, names, *args):
    output = tm(command, *args, '-F', SEP.join('#{' + name + '}' for name in names))
    if not output:
        return []
    rows = []
    for line in output.splitlines():
        values = line.split(SEP)
        if len(values) != len(names):
            raise ValueError('A workspace name or directory contains unsupported control characters')
        rows.append(dict(zip(names, values)))
    return rows


def panes():
    return fields('list-panes', ['session_id', 'session_name', 'window_id', 'window_index', 'pane_id', 'pane_index', 'pane_pid', 'pane_current_path', 'pane_active', 'pane_dead', 'pane_tty', 'pane_current_command', 'pane_title', '@workspace_id', '@workspace_app', '@workspace_label', '@workspace_parked', '@workspace_home'], '-a')


def pane_info(pane):
    return next(p for p in panes() if p['pane_id'] == pane)


AGENT_COLOURS = {'blocked': 31, 'done': 36, 'working': 33, 'idle': 32}  # Most urgent first.


def roll_up(rows):
    """Roll pane status up per tab and per workspace with the rules of agent-status.conf."""
    by_pane, by_tab, by_workspace = {}, {}, {}
    rank = list(AGENT_COLOURS).index
    for row in rows:
        status = row['@workspace_agent']
        if row['pane_current_command'] == 'zsh' or status not in AGENT_COLOURS:
            continue
        by_pane[row['pane_id']] = status
        workspace = row['@workspace_home'] if row['session_name'] == PARKING else row['session_name']
        for group, key in ((by_tab, row['window_id']), (by_workspace, workspace)):
            group[key] = min(group.get(key, status), status, key=rank)
    return by_pane, by_tab, by_workspace


def agent_status():
    """Read every pane once. A failed read gives no status, so the pickers still list their rows."""
    try:
        return roll_up(fields('list-panes', ['session_name', 'window_id', 'pane_id', 'pane_current_command', '@workspace_agent', '@workspace_home'], '-a'))
    except Exception:
        return {}, {}, {}


STATUS_WIDTH = max(map(len, AGENT_COLOURS))


def status_word(status):
    return f'\x1b[{AGENT_COLOURS[status]}m{status.ljust(STATUS_WIDTH)}\x1b[0m' if status in AGENT_COLOURS else ''


def workspace_row(name, label, status=''):
    """fzf shows and searches the label, shows the status and prints only the name."""
    return '\t'.join((name, label.ljust(24), status_word(status)))


def picked_name(output):
    lines = [line.strip() for line in output.splitlines() if line.strip()]
    return lines[-1] if lines else ''


def tab_row(index, name, count, labels, active, status=''):
    """fzf searches only the index and the name, which stand before the tab character."""
    word = status_word(status) or ' ' * STATUS_WIDTH
    return f"{index}: {name:<16}\t{word} [{count} pane{'s' if int(count) > 1 else ''}: {labels}]{'  ● active' if active else ''}"


def tab_index(row):
    return row.split(':')[0].strip()


def parked_row(number, pane, status=''):
    return f" {number}. {pane['label']}  [{pane['home']}]" + (f'  {status_word(status)}' if status else '')


def message(text):
    if os.environ.get('TMUX'):
        tm('display-message', text, check=False)
    else:
        print(text)


def atomic(path, text):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd, tmp = tempfile.mkstemp(prefix='.' + path.name, dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as stream:
            stream.write(text)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


@contextlib.contextmanager
def lock():
    ROOT.mkdir(parents=True, exist_ok=True, mode=0o700)
    ROOT.chmod(0o700)
    with (ROOT / 'lock').open('a') as stream:
        fcntl.flock(stream, fcntl.LOCK_EX)
        yield


def identity(pane):
    value = option('@workspace_id', pane)
    if not re.fullmatch(r'[0-9a-f]{32}', value):
        value = uuid.uuid4().hex
        put('@workspace_id', value, pane)
    return value


def clean_label(value):
    value = ''.join(c for c in value if c.isprintable()).strip()
    return value[:80] or 'shell'


def set_label(pane, value):
    value = clean_label(value)
    put('@workspace_label', value, pane)


def ask_label(pane, initial='shell'):
    try:
        label = input('Pane label [' + initial + ']: ').strip() or initial
    except (EOFError, KeyboardInterrupt):
        label = initial
        print()
    set_label(pane, label)


def process_table():
    result = subprocess.run(['ps', '-axo', 'pid=,ppid=,pgid=,tpgid=,lstart='], capture_output=True, text=True, check=True)
    table = {}
    for line in result.stdout.splitlines():
        parts = line.split(None, 4)
        if len(parts) == 5:
            try:
                table[int(parts[0])] = (int(parts[1]), int(parts[2]), int(parts[3]), parts[4].strip())
            except ValueError:
                pass
    return table


def live_app(pane, table):
    raw = pane['@workspace_app'] if '@workspace_app' in pane else option('@workspace_app', pane['pane_id'])
    if not raw:
        return None
    try:
        app = json.loads(raw)
        pid = int(app['pid'])
        proc = table.get(pid)
        if not proc or proc[3] != app['birth'] or app['kind'] not in APP_COMMANDS:
            return None
        # A stopped/background job is not what the user is currently running.
        if proc[2] > 0 and proc[1] != proc[2]:
            return None
        ancestor = pid
        seen = set()
        while ancestor and ancestor not in seen:
            if ancestor == int(pane['pane_pid']):
                break
            seen.add(ancestor)
            ancestor = table.get(ancestor, (0,))[0]
        else:
            return None
        if not isinstance(app.get('id'), str) or not app['id']:
            return {'kind': app['kind'], 'error': 'No exact conversation identity was recorded'}
        return app
    except (ValueError, KeyError, TypeError):
        return None


def snapshot(force=False):
    with lock():
        if option('@workspace_restoring') == '1':
            return
        now = time.time()
        try:
            last = json.loads((ROOT / 'latest.json').read_text())
            if not force and now - last['saved_at'] < 300:
                return
        except (FileNotFoundError, ValueError, KeyError):
            pass
        all_panes = panes()
        if not all_panes:
            return
        table = process_table()
        agent_hooks = runpy.run_path(str(Path.home() / '.local/lib/tmux-workspace/agent-hook.py'))
        codex_processes = None
        codex_scan_error = None
        snapshot_id = str(time.time_ns())
        directory = ROOT / 'snapshots' / snapshot_id
        directory.mkdir(parents=True, mode=0o700)
        saved_panes = []
        for pane in all_panes:
            if pane['session_name'] == '__workspace_bootstrap':
                continue
            pid = pane['pane_id']
            uid = pane['@workspace_id']
            if not re.fullmatch(r'[0-9a-f]{32}', uid):
                uid = identity(pid)
            app = live_app(pane, table)
            codex = None
            current_codex = (app and app.get('kind') == 'codex' and not app.get('error')
                             and pane['pane_title'] in ('codex | ' + app['id'], 'codex | ' + app['id'][:29] + '...'))
            if not current_codex:
                try:
                    if codex_processes is None:
                        try:
                            codex_processes = agent_hooks['process_table']()
                        except (OSError, ValueError, subprocess.SubprocessError) as exc:
                            codex_processes, codex_scan_error = {}, str(exc)
                    if codex_scan_error and pane['pane_current_command'] == 'codex':
                        codex = {'kind': 'codex', 'error': codex_scan_error}
                    else:
                        codex = agent_hooks['resolve_codex'](
                            int(pane['pane_pid']), pane['pane_tty'], pane['pane_title'],
                            pane['pane_current_path'], processes=codex_processes)
                except (OSError, ValueError, subprocess.SubprocessError) as exc:
                    codex = {'kind': 'codex', 'error': 'Identity lookup failed: ' + str(exc)}
            if codex:
                app = codex
            elif not app and pane['pane_current_command'] in APP_COMMANDS:
                app = {'kind': pane['pane_current_command'], 'error': 'Active application has no verified conversation/session identity'}
            if app and app.get('kind') == 'nvim' and app.get('socket'):
                result = subprocess.run(['nvim', '--server', app['socket'], '--remote-expr', "luaeval(\"require('custom.tmux_workspace').save()\")"], capture_output=True, text=True, timeout=10)
                if result.returncode != 0 or not Path(app['id']).is_file():
                    app = {'kind': 'nvim', 'error': 'Could not save the active Neovim session'}
            record = {
                'id': uid, 'session': pane['session_name'], 'window': int(pane['window_index']),
                'index': int(pane['pane_index']), 'label': pane['@workspace_label'] or 'shell',
                'cwd': pane['pane_current_path'], 'active': pane['pane_active'] == '1',
                'parked': pane['@workspace_parked'], 'home': pane['@workspace_home'],
                'app': app,
            }
            if record['session'] == PARKING and not record['parked']:
                continue
            # Plain text deliberately excludes executable terminal escape sequences.
            content = tm('capture-pane', '-p', '-J', '-S', '-', '-t', pid)
            atomic(directory / (uid + '.txt'), content + '\n')
            saved_panes.append(record)
        windows = fields('list-windows', ['session_name', 'window_index', 'window_name', 'window_layout', 'window_active', 'window_width', 'window_height', 'window_zoomed_flag'], '-a')
        windows = [w for w in windows if any(p['session'] == w['session_name'] and p['window'] == int(w['window_index']) for p in saved_panes)]
        active = tm('display-message', '-p', '#{client_session}', check=False)
        data = {'version': 1, 'saved_at': now, 'directory': str(directory), 'active_session': active, 'windows': windows, 'panes': saved_panes}
        atomic(directory / 'workspace.json', json.dumps(data, indent=2))
        atomic(ROOT / 'latest.json', json.dumps({'saved_at': now, 'path': str(directory / 'workspace.json')}))
        put('@workspace_saved', time.strftime('%H:%M', time.localtime(now)))
        put('@workspace_save_error', '')
        # Keep three complete snapshots; never prune editor sessions or AI history.
        old = sorted((ROOT / 'snapshots').iterdir(), key=lambda p: p.name, reverse=True)
        for path in old[3:]:
            if path.is_dir() and path.name.isdigit():
                shutil.rmtree(path)
    if force:
        message('Workspace saved (layouts, labels, history, active AI/editor identities)')


def read_snapshot():
    try:
        latest = json.loads((ROOT / 'latest.json').read_text())
        path = Path(latest['path'])
        data = json.loads(path.read_text())
        if data['version'] != 1:
            raise ValueError('Unsupported workspace snapshot version')
        return path, data
    except FileNotFoundError:
        return None, None


def pane_start(snapshot_path=None, uid=None):
    pane = os.environ.get('TMUX_PANE')
    if not pane:
        raise ValueError('pane-start must run inside tmux')
    if snapshot_path:
        data = json.loads(Path(snapshot_path).read_text())
        record = next(p for p in data['panes'] if p['id'] == uid)
        put('@workspace_id', uid, pane)
        set_label(pane, record['label'])
        for key in ('parked', 'home'):
            if record[key]:
                put('@workspace_' + key, record[key], pane)
        history = Path(data['directory']) / (uid + '.txt')
        if history.is_file():
            print('── Saved terminal text · ' + time.strftime('%Y-%m-%d %H:%M', time.localtime(data['saved_at'])) + ' ──', flush=True)
            text = history.read_text()
            # Never replay control sequences from a stored terminal snapshot.
            print(''.join(c for c in text if c in '\n\t' or c.isprintable()), end='', flush=True)
            print('── End saved text · prior processes are not running ──', flush=True)
        # Hold application startup until every pane/layout has been reconstructed.
        while option('@workspace_restoring') == '1':
            time.sleep(0.1)
        app = record.get('app')
        if app:
            error = app.get('error')
            kind = app.get('kind')
            token = app.get('id')
            if not error and (kind not in APP_COMMANDS or not isinstance(token, str) or not token or token.startswith('-')):
                error = 'Missing or invalid exact recovery identity'
            if not error and kind in ('nvim', 'omp') and token.startswith('/') and not Path(token).is_file():
                error = 'Saved session file no longer exists: ' + token
            if error:
                print('Recovery needs attention: ' + error, flush=True)
            else:
                command = APP_COMMANDS[kind] + [token]
                print('Reopening ' + kind + ' for pane ' + record['label'] + ' (no prompt replay).', flush=True)
                try:
                    result = subprocess.run(command, cwd=app.get('cwd') or record['cwd'])
                    if result.returncode:
                        print(f'{kind} exited with status {result.returncode}; no other conversation was substituted.', flush=True)
                except (OSError, KeyboardInterrupt) as exc:
                    print('Recovery needs attention: ' + str(exc), flush=True)
    else:
        identity(pane)
        if not option('@workspace_label', pane):
            ask_label(pane)
    os.execv('/bin/zsh', ['/bin/zsh', '-l'])


def restore(locked=False):
    with contextlib.nullcontext() if locked else lock():
        path, data = read_snapshot()
        if not data:
            return False
        existing = {p['session_name'] for p in panes()}
        wanted = {p['session'] for p in data['panes']} - existing
        if not wanted:
            return False
        put('@workspace_restoring', '1')
        try:
            for name in sorted(wanted):
                windows = sorted((w for w in data['windows'] if w['session_name'] == name), key=lambda w: int(w['window_index']))
                sid = None
                for window in windows:
                    records = sorted((p for p in data['panes'] if p['session'] == name and p['window'] == int(window['window_index'])), key=lambda p: p['index'])
                    if not records:
                        continue
                    first = records[0]
                    cwd = first['cwd'] if Path(first['cwd']).is_dir() else str(Path.home())
                    command = shlex.join([SELF, 'pane-start', str(path), first['id']])
                    if sid is None:
                        out = tm('new-session', '-d', '-P', '-F', '#{session_id}' + SEP + '#{window_id}' + SEP + '#{pane_id}', '-s', name, '-n', window['window_name'], '-x', window['window_width'], '-y', window['window_height'], '-c', cwd, command)
                        sid, wid, first_pid = out.split(SEP)
                        index = tm('display-message', '-p', '-t', wid, '#{window_index}')
                        if index != window['window_index']:
                            tm('move-window', '-s', wid, '-t', sid + ':' + window['window_index'])
                    else:
                        out = tm('new-window', '-d', '-P', '-F', '#{window_id}' + SEP + '#{pane_id}', '-t', sid + ':' + window['window_index'], '-n', window['window_name'], '-c', cwd, command)
                        wid, first_pid = out.split(SEP)
                    active_pane = first_pid
                    for record in records[1:]:
                        cwd = record['cwd'] if Path(record['cwd']).is_dir() else str(Path.home())
                        command = shlex.join([SELF, 'pane-start', str(path), record['id']])
                        new_pid = tm('split-window', '-d', '-h', '-P', '-F', '#{pane_id}', '-t', wid, '-c', cwd, command)
                        tm('select-layout', '-t', wid, 'tiled')
                        if record['active']:
                            active_pane = new_pid
                    tm('select-layout', '-t', wid, window['window_layout'])
                    tm('select-pane', '-t', active_pane)
                    if window['window_zoomed_flag'] == '1':
                        tm('resize-pane', '-Z', '-t', active_pane)
                    if window['window_active'] == '1':
                        tm('select-window', '-t', wid)
            preferred = data.get('active_session')
            if preferred in wanted and preferred != PARKING:
                tm('switch-client', '-t', '=' + preferred, check=False)
        finally:
            put('@workspace_restoring', '0')
    return True


def initialize():
    # Set in the server, not in shell environment, so configuration reloads do not
    # start duplicate timers or repeatedly restore deliberately closed sessions.
    if option('@workspace_initialized') == '1':
        return
    with lock():
        if option('@workspace_initialized') == '1':
            return
        restore(locked=True)
        put('@workspace_initialized', '1')
        tm('run-shell', '-b', '-d', '300', shlex.join([SELF, 'tick']))


def tick():
    os.nice(10)
    try:
        snapshot()
    except Exception as exc:
        put('@workspace_save_error', str(exc))
        message('Workspace autosave failed: ' + str(exc))
    finally:
        tm('run-shell', '-b', '-d', '300', shlex.join([SELF, 'tick']), check=False)


def park(pane):
    current = pane_info(pane)
    if current['session_name'] == PARKING:
        raise ValueError('This pane is already parked')
    siblings = [p for p in panes() if p['window_id'] == current['window_id']]
    if len(siblings) == 1:
        raise ValueError('This is the only pane. Create a split first, or switch windows.')
    placeholder = None
    if not any(p['session_name'] == PARKING for p in panes()):
        placeholder = tm('new-session', '-d', '-P', '-F', '#{pane_id}', '-s', PARKING, '-n', 'holding', '/bin/sleep 2147483647')
    put('@workspace_parked', time.time_ns(), pane)
    put('@workspace_home', current['session_name'], pane)
    label = option('@workspace_label', pane) or 'shell'
    try:
        tm('break-pane', '-d', '-s', pane, '-t', '=' + PARKING + ':', '-n', label)
    except Exception:
        tm('set-option', '-pu', '-t', pane, '@workspace_parked', check=False)
        raise
    finally:
        if placeholder:
            tm('kill-pane', '-t', placeholder, check=False)
    message('Parked ' + label + ' — prefix u restores; prefix U chooses')


def parked():
    result = []
    for pane in panes():
        stamp = option('@workspace_parked', pane['pane_id'])
        if pane['session_name'] == PARKING and stamp:
            pane.update(label=option('@workspace_label', pane['pane_id']) or 'shell', home=option('@workspace_home', pane['pane_id']), stamp=int(stamp))
            result.append(pane)
    return sorted(result, key=lambda p: p['stamp'], reverse=True)


def unpark(target, direction='right', choose=False):
    choices = parked()
    if not choices:
        raise ValueError('No parked panes')
    if pane_info(target)['session_name'] == PARKING:
        raise ValueError('Switch to a project window before restoring a parked pane')
    selected = choices[0]
    if choose:
        print('Parked panes — restore ' + direction + ' of the selected pane\n')
        by_pane = agent_status()[0]
        for i, pane in enumerate(choices, 1):
            print(parked_row(i, pane, by_pane.get(pane['pane_id'], '')))
        answer = input('\nNumber (Enter cancels): ').strip()
        if not answer:
            return
        if not answer.isdigit() or not 1 <= int(answer) <= len(choices):
            raise ValueError('Choose a listed pane number')
        selected = choices[int(answer) - 1]
    source = selected['pane_id']
    tm('join-pane', '-h' if direction == 'right' else '-v', '-s', source, '-t', target, '-l', '40%')
    tm('set-option', '-pu', '-t', source, '@workspace_parked')
    tm('set-option', '-pu', '-t', source, '@workspace_home')

def session_names():
    try:
        return [s['session_name'] for s in fields('list-sessions', ['session_name']) if s['session_name'] not in (PARKING, '__workspace_bootstrap')]
    except Exception:
        return []


def connect_session(name):
    inside = bool(os.environ.get('TMUX'))
    if inside:
        tm('switch-client', '-t', '=' + name, check=False)
    else:
        os.execv(TMUX, [TMUX, 'attach-session', '-t', '=' + name])


# fzf searches only the label and prints only the hidden name, or the typed text when no row matches.
TAB_FZF = ['fzf', '--ansi', '--delimiter=\t', '--nth=1']
WORKSPACE_FZF = ['fzf', '--delimiter=\t', '--with-nth=2..', '--nth=1', '--accept-nth=1', '--ansi', '--tiebreak=index', '--bind=enter:accept-or-print-query']


def choose_or_create_workspace():
    session_format = SEP.join(('#{session_name}', '#{session_last_attached}', '#{@workspace_initialized}'))
    sessions = tm('list-sessions', '-F', session_format, check=False)
    running = bool(sessions)
    if not running and (ROOT / 'latest.json').is_file():
        bootstrap = tm('new-session', '-d', '-P', '-F', '#{session_id}', '-s', '__workspace_bootstrap', '/bin/sleep 2147483647')
        initialize()
        if any(p['session_name'] != '__workspace_bootstrap' for p in panes()):
            tm('kill-session', '-t', bootstrap)
        sessions = tm('list-sessions', '-F', session_format, check=False)
    elif running and any(line.rsplit(SEP, 1)[-1] != '1' for line in sessions.splitlines()):
        initialize()
        sessions = tm('list-sessions', '-F', session_format, check=False)

    recent = sorted((line.rsplit(SEP, 2) for line in sessions.splitlines()),
                    key=lambda row: int(row[1] or 0), reverse=True)
    live = [row[0] for row in recent]
    live = [s for s in live if s not in (PARKING, '__workspace_bootstrap')]
    projects = []
    if PROJECTS_ROOT.is_dir():
        for p in sorted(PROJECTS_ROOT.iterdir()):
            if p.is_dir() and not p.name.startswith('.'):
                projects.append(p.name)

    zoxide_list = []
    try:
        z_out = subprocess.run(['zoxide', 'query', '-l'], capture_output=True, text=True).stdout
        for line in z_out.splitlines():
            p = Path(line.strip()).expanduser()
            if p.is_dir() and p.name not in live and p.name not in projects and not str(p).startswith(str(PROJECTS_ROOT)):
                zoxide_list.append(str(p))
    except Exception:
        pass

    by_workspace = agent_status()[2]
    display_items = []
    for s in live:
        display_items.append(workspace_row(s, f"● {s}", by_workspace.get(s, '')))
    for z in zoxide_list:
        display_items.append(workspace_row(z, f"⚡ {z}"))
    for p in projects:
        if p not in live:
            display_items.append(workspace_row(p, f"📁 {p}"))

    if not shutil.which('fzf') or not (sys.stdin.isatty() and sys.stdout.isatty()):
        command = ['sesh', 'picker']
        os.execvp('sesh', command)

    fzf_cmd = WORKSPACE_FZF + [
        '--header=Recent workspaces first | Select or type a NEW name | Esc: cancel',
        '--prompt=Workspace > ',
        '--height=50%',
        '--layout=reverse',
        '--border=rounded',
        '--info=inline'
    ]
    p = subprocess.run(fzf_cmd, input='\n'.join(display_items), text=True, capture_output=True)
    if p.returncode != 0:
        return
    target = picked_name(p.stdout)
    if target:
        open_workspace(target)


def open_workspace(name=None):
    if not name:
        choose_or_create_workspace()
        return

    running = subprocess.run([TMUX, 'has-session'], capture_output=True).returncode == 0
    if not running and (ROOT / 'latest.json').is_file():
        bootstrap = tm('new-session', '-d', '-P', '-F', '#{session_id}', '-s', '__workspace_bootstrap', '/bin/sleep 2147483647')
        initialize()
        if any(p['session_name'] != '__workspace_bootstrap' for p in panes()):
            tm('kill-session', '-t', bootstrap)
    elif running:
        initialize()

    clean = ''.join(c for c in name if c.isprintable()).strip()
    for icon in ('● ', '📁 ', '⚡ '):
        if clean.startswith(icon):
            clean = clean[len(icon):]

    live = session_names()
    if clean in live:
        connect_session(clean)
        return

    z_match = None
    if clean != '.':
        try:
            zr = subprocess.run(['zoxide', 'query', clean], capture_output=True, text=True)
            if zr.returncode == 0 and zr.stdout.strip():
                zp = Path(zr.stdout.strip()).expanduser().resolve()
                if zp.is_dir():
                    z_match = zp
        except Exception:
            pass

    if z_match:
        target_dir = z_match
        session_name = target_dir.name
    elif clean == '.':
        target_dir = Path.cwd().resolve()
        session_name = target_dir.name
    elif Path(clean).expanduser().is_dir():
        target_dir = Path(clean).expanduser().resolve()
        session_name = target_dir.name
    else:
        session_name = clean
        target_dir = (PROJECTS_ROOT / clean).resolve()
    target_dir.mkdir(parents=True, exist_ok=True)
    try:
        subprocess.run(['zoxide', 'add', str(target_dir)], capture_output=True)
    except Exception:
        pass

    if session_name not in session_names():
        tm('new-session', '-d', '-s', session_name, '-c', str(target_dir))

    connect_session(session_name)


def delete_workspace(name=None):
    live = [s for s in session_names() if s not in (PARKING, '__workspace_bootstrap')]
    if not live:
        message('No active workspaces to delete.')
        return

    if not name:
        if shutil.which('fzf') and sys.stdin.isatty():
            fzf_cmd = [
                'fzf',
                '--header=Select workspace to close/delete | Esc: cancel',
                '--prompt=Delete Workspace > ',
                '--height=40%',
                '--layout=reverse',
                '--border=rounded'
            ]
            p = subprocess.run(fzf_cmd, input='\n'.join(live), text=True, capture_output=True)
            if p.returncode != 0 or not p.stdout.strip():
                return
            target = p.stdout.strip()
        else:
            print('Active workspaces:\n')
            for i, item in enumerate(live, 1):
                print(f'  {i}. {item}')
            ans = input('\nNumber or name of workspace to delete (Enter cancels): ').strip()
            if not ans:
                return
            target = live[int(ans) - 1] if ans.isdigit() and 1 <= int(ans) <= len(live) else ans
    else:
        target = name.strip()

    if target not in live:
        message(f"Workspace '{target}' not found.")
        return

    if sys.stdin.isatty():
        try:
            confirm = input(f"Are you sure you want to close workspace '{target}'? (y/N): ").strip().lower()
            if confirm not in ('y', 'yes'):
                print('Cancelled.')
                return
        except (EOFError, KeyboardInterrupt):
            return
    inside = bool(os.environ.get('TMUX'))
    current_session = tm('display-message', '-p', '#{session_name}', check=False) if inside else None
    if inside and current_session == target:
        other = next((s for s in live if s != target), None)
        if other:
            tm('switch-client', '-t', '=' + other, check=False)
        else:
            tm('new-session', '-d', '-s', 'main', '-c', str(PROJECTS_ROOT))
            tm('switch-client', '-t', '=main', check=False)

    tm('kill-session', '-t', '=' + target)
    message(f"Workspace '{target}' closed.")
def window_preview(window_index=None):
    session = tm('display-message', '-p', '#{session_name}', check=False)
    if not session:
        return
    idx = str(window_index).strip().split(':')[0] if window_index else '1'
    try:
        raw_win = tm('display-message', '-p', '-t', f"={session}:{idx}", '#{window_name} (#{window_panes} panes)', check=False)
        print(f"=== Window {idx}: {raw_win} ===\n")
        raw_panes = tm('list-panes', '-t', f"={session}:{idx}",
                       '-F', '  • Pane #{pane_index}: #{?@workspace_label,#{@workspace_label},#{pane_current_command}} (#{pane_current_command}) in #{pane_current_path}',
                       check=False)
        if raw_panes:
            print(raw_panes)
        print("\n--- Terminal View ---\n")
        screen = tm('capture-pane', '-p', '-t', f"={session}:{idx}", check=False)
        print(screen)
    except Exception as e:
        print(f"Preview unavailable: {e}")


def pick_window():
    session = tm('display-message', '-p', '#{session_name}', check=False)
    if not session:
        message('No active tmux session.')
        return

    rows = fields('list-panes', ['session_name', 'window_id', 'window_index', 'window_name',
                  'window_active', 'window_panes', 'pane_id', 'pane_index', 'pane_current_command',
                  '@workspace_label', '@workspace_agent', '@workspace_home'], '-s', '-t', '=' + session)
    if not rows:
        message('No windows found.')
        return

    by_tab = roll_up(rows)[1]
    windows = {}
    for row in rows:
        windows.setdefault(row['window_id'], []).append(row)
    display_items = []
    for wid, members in windows.items():
        row = members[0]
        labels = ', '.join(p['pane_index'] + ':' + (p['@workspace_label'] or p['pane_current_command']) for p in members)
        display_items.append(tab_row(row['window_index'], row['window_name'], row['window_panes'], labels,
                                     row['window_active'] == '1', by_tab.get(wid, '')))

    if not shutil.which('fzf') or not (sys.stdin.isatty() and sys.stdout.isatty()):
        tm('choose-tree', '-Zw', '-t', f"={session}", '-f', f"#{{==:#{{session_name}},{session}}}")
        return

    fzf_cmd = TAB_FZF + [
        f'--preview={shlex.quote(SELF)} window-preview {{1}}',
        '--preview-window=right:55%:wrap',
        '--header=Select window to switch | Esc: cancel',
        '--prompt=Window > ',
        '--height=100%',
        '--layout=reverse',
        '--border=rounded',
        '--info=inline'
    ]
    p = subprocess.run(fzf_cmd, input='\n'.join(display_items), text=True, capture_output=True)
    if p.returncode != 0 or not p.stdout.strip():
        return
    tm('select-window', '-t', f"={session}:{tab_index(p.stdout)}")


def new_tab(name=None, cwd=None):
    if not cwd or not Path(cwd).is_dir():
        session_cwd = tm('display-message', '-p', '#{session_path}', check=False).strip()
        cwd = session_cwd if session_cwd and Path(session_cwd).is_dir() else str(PROJECTS_ROOT)
    clean = ''.join(c for c in (name or '') if c.isprintable()).strip()
    tab_name = clean if clean else 'tab'
    new_pane_id = tm('new-window', '-P', '-F', '#{pane_id}', '-c', cwd, '-n', tab_name)
    put('@workspace_label', tab_name, new_pane_id)



def history(pane):
    _, data = read_snapshot()
    if not data:
        raise ValueError('No saved history yet; use prefix Ctrl+s first')
    uid = identity(pane)
    path = Path(data['directory']) / (uid + '.txt')
    if not path.is_file():
        raise ValueError('This pane is not in the latest snapshot')
    os.execvp('less', ['less', '--', str(path)])


