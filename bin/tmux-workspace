def help_topic(topic_id):
    for t in HELP_TOPICS:
        if t['id'] == topic_id:
            print(f"=== {t['title']} ===\n\n{t['text']}\n")
            return
    print(f"Topic '{topic_id}' not found.")


def help_interactive():
    guide = Path.home() / '.config/tmux/WORKSPACE_GUIDE.md'
    has_fzf = shutil.which('fzf')
    is_tty = sys.stdin.isatty() and sys.stdout.isatty()
    if not has_fzf or not is_tty:
        if guide.is_file() and shutil.which('less') and is_tty:
            os.execvp('less', ['less', '-R', '--', str(guide)])
        elif guide.is_file():
            print(guide.read_text())
        else:
            for t in HELP_TOPICS:
                help_topic(t['id'])
        return

    while True:
        input_data = '\n'.join(f"{t['id']}\t{t['display']}" for t in HELP_TOPICS)
        fzf_cmd = [
            'fzf',
            '--delimiter=\t',
            '--with-nth=2',
            f'--preview={shlex.quote(SELF)} help-topic {{1}}',
            '--preview-window=right:58%:wrap',
            '--header=Type to fuzzy search commands | Enter: view full help | Esc: quit',
            '--prompt=Help > ',
            '--info=inline',
            '--height=100%',
            '--layout=reverse',
            '--border=rounded'
        ]
        p = subprocess.run(fzf_cmd, input=input_data, text=True, capture_output=True)
        if p.returncode != 0 or not p.stdout.strip():
            break
        selected_id = p.stdout.strip().split('\t')[0]
        if selected_id == 'topic-guide':
            if guide.is_file() and shutil.which('less'):
                subprocess.run(['less', '-R', '--', str(guide)])
        else:
            topic_record = next((t for t in HELP_TOPICS if t['id'] == selected_id), None)
            if topic_record:
                body = f"=== {topic_record['title']} ===\n\n{topic_record['text']}\n\n[Press 'q' or 'Enter' to return to search...]"
                if shutil.which('less'):
                    subprocess.run(['less', '-R', '-P', ' Press q to return to search...'], input=body, text=True)
                else:
                    print(body)
                    try:
                        input()
                    except (EOFError, KeyboardInterrupt):
                        pass

def main():
    args = sys.argv[1:]
    command = args.pop(0) if args else 'open'
    if command == 'ai':
        sys.path.insert(0, str(Path(SELF).parent.parent / 'lib'))
        import ai
        ai.main(globals(), args)
    elif command == 'doctor':
        sys.path.insert(0, str(Path(SELF).parent.parent / 'lib'))
        from diagnostics import doctor
        sys.exit(doctor(globals()))
    elif command == 'cleanup':
        sys.path.insert(0, str(Path(SELF).parent.parent / 'lib'))
        from cleanup import cleanup
        cleanup(globals())
    elif command == 'pane-start':
        pane_start(*args)
    elif command == 'open':
        open_workspace(*args)
    elif command == 'init':
        initialize()
    elif command == 'tick':
        tick()
    elif command == 'save':
        snapshot(force=True)
    elif command == 'restore':
        message('Missing workspaces restored' if restore() else 'No missing saved workspaces to restore')
    elif command == 'park':
        park(*args)
    elif command in ('unpark', 'choose-park'):
        target = tm('display-message', '-p', '#{pane_id}')
        direction = 'right'
        if args and (args[0].startswith('%') or args[0].isdigit()):
            target = args.pop(0)
        if args:
            direction = args[0]
        unpark(target, direction, choose=command == 'choose-park')
    elif command == 'label':
        pane = args[0] if args else tm('display-message', '-p', '#{pane_id}')
        ask_label(pane, option('@workspace_label', pane) or 'shell')
    elif command == 'history':
        history(args[0] if args else tm('display-message', '-p', '#{pane_id}'))
    elif command == 'help':
        help_interactive()
    elif command == 'new-tab':
        new_tab(*args)
    elif command == 'help-topic':
        help_topic(args[0] if args else '')
    elif command == 'pick-window':
        pick_window()
    elif command == 'window-preview':
        window_preview(*args)
    elif command in ('kill-workspace', 'delete', 'rm'):
        delete_workspace(*args)
    else:
        raise ValueError('Unknown workspace command: ' + command)

if __name__ == '__main__':
    try:
        main()
    except (ValueError, OSError, subprocess.SubprocessError, StopIteration) as exc:
        sys.stderr.write(f"Workspace error: {exc}\n")
        message('Workspace: ' + str(exc))
        sys.exit(1)
    except (EOFError, KeyboardInterrupt):
        sys.exit(0)
