#!/bin/sh
# Play the sound for an agent status: tw-sound blocked|done. `tw-sound which` names the player.
# Silent when no player or no sound file exists, and always exits 0.

has() { command -v "$1" >/dev/null 2>&1; }

if [ "$(uname -s)" = Darwin ]; then
    player=afplay
    blocked=/System/Library/Sounds/Funk.aiff
    done=/System/Library/Sounds/Glass.aiff
else
    player=
    for candidate in pw-play paplay; do
        if has "$candidate"; then player=$candidate; break; fi
    done
    dir=${TW_SOUND_DIR:-/usr/share/sounds/freedesktop/stereo}
    blocked=$dir/dialog-warning.oga
    done=$dir/complete.oga
fi

case "${1:-}" in
blocked) file=$blocked ;;
done) file=$done ;;
which)
    if [ -n "$player" ] && has "$player"; then echo "$player"; else echo none; fi
    exit 0
    ;;
*) exit 0 ;;
esac

if [ -n "$player" ] && has "$player"; then
    if [ "$player" = afplay ] || [ -f "$file" ]; then
        "$player" "$file" >/dev/null 2>&1
    fi
fi
exit 0
