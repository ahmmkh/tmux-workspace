#!/usr/bin/env python3
"""Register tmux-workspace with the agents and editors on this machine, with backups.

Claude Code, Codex, omp and Neovim are set up only when their config directory exists.
The iTerm2 profile is installed only on macOS. Running it again changes nothing.
"""
import json
import os
from pathlib import Path
import platform
import sys
import tempfile
import time

PROJECT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(PROJECT / 'lib'))
from paths import render_hooks  # noqa: E402

MARK = 'agent-hook.py'  # Every hook command this project registers names this file.


def hook_path(home):
    return home / '.local/lib/tmux-workspace/agent-hook.py'


render = render_hooks


def merge_hooks(existing, wanted):
    """Drop this project's old hook entries, keep everyone else's, then add the wanted groups."""
    data = json.loads(json.dumps(existing))
    hooks = data.setdefault('hooks', {})
    for event in list(hooks):
        groups = []
        for group in hooks[event]:
            kept = [h for h in group.get('hooks', []) if MARK not in h.get('command', '')]
            if kept:
                groups.append(dict(group, hooks=kept))
        hooks[event] = groups
    for event, groups in wanted.items():
        hooks.setdefault(event, []).extend(json.loads(json.dumps(groups)))
    hooks = {event: groups for event, groups in hooks.items() if groups}
    data['hooks'] = hooks
    return data, data != existing


class Installer:
    def __init__(self, home):
        self.home = home
        self.backups = home / '.local/state/tmux-workspace/backups' / ('integrations-' + str(time.time_ns()))
        self.actions = []

    def backup(self, path):
        self.backups.mkdir(parents=True, exist_ok=True)
        (self.backups / path.name).write_bytes(path.read_bytes())

    def link(self, link, source):
        if link.is_symlink() and link.resolve() == source.resolve():
            return
        link.parent.mkdir(parents=True, exist_ok=True)
        if link.exists() and not link.is_symlink():
            self.backup(link)
        temporary = link.with_name('.tmux-workspace-' + str(time.time_ns()))
        try:
            temporary.symlink_to(source)
            temporary.replace(link)
        finally:
            temporary.unlink(missing_ok=True)
        self.actions.append(f'link {link} -> {source}')

    def write_json(self, path, data, original):
        """Replace path atomically, unless someone else changed it while we worked."""
        if path.exists():
            self.backup(path)
        with tempfile.NamedTemporaryFile(mode='w', dir=path.parent, delete=False) as out:
            temporary = Path(out.name)
            json.dump(data, out, indent=2)
            out.write('\n')
        try:
            if (path.read_bytes() if path.exists() else b'{}') != original:
                raise RuntimeError(f'{path} changed during installation; rerun the installer.')
            temporary.replace(path)
        finally:
            temporary.unlink(missing_ok=True)

    def hooks(self, path, template, name):
        original = path.read_bytes() if path.exists() else b'{}'
        existing = json.loads(original)  # Invalid JSON stops here and the file stays as it was.
        wanted = render(template, self.home)
        data, changed = merge_hooks(existing, wanted['hooks'])
        line = wanted.get('statusLine')
        if line:
            current = data.get('statusLine')
            if not current or MARK in current.get('command', ''):
                changed = changed or current != line
                data['statusLine'] = line
            else:
                self.actions.append(f"{name} statusLine kept: {current.get('command', '')}")
        if changed:
            self.write_json(path, data, original)
            self.actions.append(f'{name} hooks installed in {path}')
        return changed

    def run(self, system):
        os.umask(0o077)
        home = self.home
        self.link(hook_path(home), PROJECT / 'integrations/agent-hook.py')
        codex = Path(os.environ.get('CODEX_HOME') or home / '.codex')
        if codex.is_dir():
            if self.hooks(codex / 'hooks.json', PROJECT / 'integrations/codex-hooks.json', 'Codex'):
                # Trust belongs to Codex's /hooks review; never edit the trusted hashes.
                self.actions.append('In Codex, review the agent-hook.py entries with /hooks, then restart running CLIs.')
        if (home / '.claude').is_dir():
            self.hooks(home / '.claude/settings.json', PROJECT / 'integrations/claude-hooks.json', 'Claude')
        if (home / '.omp').is_dir():
            self.link(home / '.omp/agent/extensions/tmux-workspace.ts', PROJECT / 'integrations/tmux-workspace.ts')
        if (home / '.config/nvim').is_dir():
            if self.link_changed(home / '.config/nvim/lua/custom/tmux_workspace.lua', PROJECT / 'integrations/tmux_workspace.lua'):
                self.actions.append("Neovim: add require('custom.tmux_workspace').setup() to init.lua")
        if system == 'Darwin':
            if self.link_changed(home / 'Library/Application Support/iTerm2/DynamicProfiles/tmux-workspace.json',
                                 PROJECT / 'integrations/iterm2-profile.json'):
                self.actions.append('iTerm2: select Profiles > tmux workspace for a new tab.')
        if self.backups.exists():
            self.actions.append(f'backups in {self.backups}')
        return self.actions

    def link_changed(self, link, source):
        count = len(self.actions)
        self.link(link, source)
        return len(self.actions) > count


def install(home, system=None):
    return Installer(home).run(system or platform.system())


if __name__ == '__main__':
    done = install(Path.home())
    print('\n'.join(done) if done else 'Integrations already installed.')
